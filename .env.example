# Copy to .env (git-ignored) and replace every value before `docker compose up`.
# These are placeholders, not real secrets.

# SQL Server SA password: at least 8 characters with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=ChangeMe-Strong-Passw0rd!

# JWT signing key: at least 32 bytes. Generate one, for example: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-string-of-at-least-32-bytes

# Optional: creates the first Administrator at startup. Leave empty to skip.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
