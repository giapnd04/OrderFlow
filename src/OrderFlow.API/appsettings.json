{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "OrderFlow",
    "Audience": "OrderFlow.Api",
    "ExpiryMinutes": 60,
    "SigningKey": ""
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "Global": { "PermitLimit": 300 },
    "Auth": { "PermitLimit": 10 }
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
